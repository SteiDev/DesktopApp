<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #3b3542;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainMenuController">
    
    <!-- Top-Right Decorative Ring -->
    <Circle centerX="1750.0" centerY="150.0" radius="320.0" stroke="#bfa1db" strokeWidth="4.0" style="-fx-fill: transparent;" opacity="0.35" />

    <!-- Balanced Bottom-Left Decorative Ring -->
    <Circle centerX="200.0" centerY="950.0" radius="250.0" stroke="#928ba7" strokeWidth="3.0" style="-fx-fill: transparent;" opacity="0.2" />

    <!-- Top-Left Profile & Username Box -->
    <HBox fx:id="profileButton" alignment="CENTER_LEFT" spacing="20.0" prefWidth="520.0" style="-fx-background-color: #4b4459; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="60.0">
        <Circle radius="26.0" stroke="#2b2633" strokeWidth="3.0" style="-fx-fill: #3b3542;" />
        <Label text="John Doe" style="-fx-text-fill: #bfa1db; -fx-font-size: 32px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -4, 4);" />
    </HBox>

    <!-- Large Tab Navigation Bar (Well spaced out below the profile box) -->
    <HBox alignment="CENTER_LEFT" spacing="30.0" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="180.0">
        <Button fx:id="synthTabBtn" text="Synthesizer" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 28px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-pref-height: 72px; -fx-padding: 0 45px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
        <Button fx:id="quizTabBtn" text="Exercises" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 28px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-pref-height: 72px; -fx-padding: 0 45px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
        <Button fx:id="dashboardTabBtn" text="Learning Dashboard" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 28px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-pref-height: 72px; -fx-padding: 0 45px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
    </HBox>

    <!-- TAB 1: SYNTHESIZER OPTIONS PANE -->
    <AnchorPane fx:id="synthPane" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="320.0" AnchorPane.rightAnchor="150.0" AnchorPane.bottomAnchor="140.0">
        <VBox spacing="45.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="60.0">
            <Label text="SELECT SYNTHESIZER ARCHITECTURE" style="-fx-text-fill: #928ba7; -fx-font-size: 26px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />

            <VBox spacing="45.0">
                <!-- Acoustic Grand Piano Option -->
                <HBox fx:id="pianoOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Acoustic Grand Piano" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>

                <!-- Organ Option -->
                <HBox fx:id="organOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Organ" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>

                <!-- Synth Lead Option -->
                <HBox fx:id="leadOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Synth Lead" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>
            </VBox>
        </VBox>
    </AnchorPane>

    <!-- TAB 2: QUIZ OPTIONS PANE (Initially Hidden) -->
    <AnchorPane fx:id="quizPane" visible="false" managed="false" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="320.0" AnchorPane.rightAnchor="150.0" AnchorPane.bottomAnchor="140.0">
        <VBox spacing="45.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="60.0">
            <Label text="SELECT QUIZ MODULE" style="-fx-text-fill: #928ba7; -fx-font-size: 26px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />

            <VBox spacing="45.0">
                <!-- Start Quiz Option -->
                <HBox fx:id="startQuizOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Start Interactive Quiz" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>

                <!-- Review Past Quizzes Option -->
                <HBox fx:id="reviewQuizOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Review Past Quizzes &amp; Stats" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>
            </VBox>
        </VBox>
    </AnchorPane>

    <!-- TAB 3: LEARNING DASHBOARD PANE (Initially Hidden) -->
    <AnchorPane fx:id="dashboardPane" visible="false" managed="false" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="320.0" AnchorPane.rightAnchor="150.0" AnchorPane.bottomAnchor="140.0">
        <VBox spacing="45.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="60.0">
            <Label text="SELECT LEARNING DASHBOARD" style="-fx-text-fill: #928ba7; -fx-font-size: 26px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />

            <VBox spacing="45.0">
                <!-- Open Dashboard Option -->
                <HBox fx:id="openDashboardOption" alignment="CENTER_LEFT" spacing="25.0" style="-fx-cursor: hand;">
                    <Label text="Learning Dashboard &amp; Progress" style="-fx-text-fill: #bfa1db; -fx-font-size: 40px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                    <Label text="-&gt;" style="-fx-text-fill: #bfa1db; -fx-font-size: 46px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                </HBox>
            </VBox>
        </VBox>
    </AnchorPane>

    <!-- Bottom-Right Logout Button -->
    <Button fx:id="logoutButton" text="Logout" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 22px; -fx-pref-height: 48px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" AnchorPane.bottomAnchor="60.0" AnchorPane.rightAnchor="80.0" />

</AnchorPane>