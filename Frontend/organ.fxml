<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #3b3542;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="OrganController">

    <!-- Top-Right Decorative Ring -->
    <Circle centerX="1750.0" centerY="150.0" radius="320.0" stroke="#bfa1db" strokeWidth="4.0" style="-fx-fill: transparent;" opacity="0.35" />

    <!-- Top Navigation Section (Stacked: Large Title on top, 3 Dropdown Buttons underneath) -->
    <VBox spacing="12.0" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="30.0">
        <Label text="Organ" style="-fx-text-fill: #bfa1db; -fx-font-size: 36px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -4, 4);" />
        
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <Button fx:id="synthMenuBtn" text="SYNTHESIZER v" prefHeight="45.0" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 16px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <Button fx:id="quizMenuBtn" text="EXERCISES v" prefHeight="45.0" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 16px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <Button fx:id="dashboardMenuBtn" text="DASHBOARD v" prefHeight="45.0" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 16px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <Label fx:id="activeNoteLabel" text="[ READY ]" style="-fx-text-fill: #928ba7; -fx-font-size: 22px; -fx-font-family: 'Super Mario World Text Box'; -fx-padding: 0 0 0 20px;" />
        </HBox>
    </VBox>

    <!-- Main 3-Row Organ Console Box (Lowered to clear the top navigation header) -->
    <VBox spacing="18.0" style="-fx-background-color: #928ba7; -fx-padding: 28px; -fx-border-color: #2b2633; -fx-border-width: 5px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -8, 8);" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="155.0">

        <!-- Stop & Coupler Switch Rail -->
        <HBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-background-color: #3b3542; -fx-padding: 14px 20px; -fx-border-color: #2b2633; -fx-border-width: 3px;">
            <Label text="COUPLERS:" style="-fx-text-fill: #bfa1db; -fx-font-size: 18px; -fx-font-family: 'Super Mario World Text Box';" />
            <ToggleButton fx:id="swToGtToggle" text="SW -> GT" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Hack', monospace; -fx-font-size: 16px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <ToggleButton fx:id="chToGtToggle" text="CH -> GT" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Hack', monospace; -fx-font-size: 16px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <ToggleButton fx:id="tremulantToggle" text="TREMULANT" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 15px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <ToggleButton fx:id="principal8Toggle" text="8' PRINCIPAL" selected="true" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 15px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <ToggleButton fx:id="octave4Toggle" text="4' OCTAVE" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 15px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
            <ToggleButton fx:id="mixtureToggle" text="IV MIXTURE" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 15px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand;" />
        </HBox>

        <!-- ROW 1: SWELL MANUAL (Upper Manual - Octave 5, 2 Octaves: C5–B6) -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #3b3542; -fx-padding: 14px 20px; -fx-border-color: #2b2633; -fx-border-width: 3px;">
            <VBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="6.0">
                <Label text="III. SWELL" style="-fx-text-fill: #bfa1db; -fx-font-size: 20px; -fx-font-family: 'Super Mario World Text Box';" />
                <Label text="C5 - B6" style="-fx-text-fill: #928ba7; -fx-font-size: 15px; -fx-font-family: 'Super Mario World Text Box';" />
            </VBox>
            <StackPane fx:id="swellManualContainer" alignment="TOP_LEFT" />
        </HBox>

        <!-- ROW 2: GREAT MANUAL (Middle Manual - Octave 4, 2 Octaves: C4–B5) -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #3b3542; -fx-padding: 14px 20px; -fx-border-color: #2b2633; -fx-border-width: 3px;">
            <VBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="6.0">
                <Label text="II. GREAT" style="-fx-text-fill: #bfa1db; -fx-font-size: 20px; -fx-font-family: 'Super Mario World Text Box';" />
                <Label text="C4 - B5" style="-fx-text-fill: #928ba7; -fx-font-size: 15px; -fx-font-family: 'Super Mario World Text Box';" />
            </VBox>
            <StackPane fx:id="greatManualContainer" alignment="TOP_LEFT" />
        </HBox>

        <!-- ROW 3: CHOIR MANUAL (Lower Manual - Octave 3, 2 Octaves: C3–B4) -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #3b3542; -fx-padding: 14px 20px; -fx-border-color: #2b2633; -fx-border-width: 3px;">
            <VBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="6.0">
                <Label text="I. CHOIR" style="-fx-text-fill: #bfa1db; -fx-font-size: 20px; -fx-font-family: 'Super Mario World Text Box';" />
                <Label text="C3 - B4" style="-fx-text-fill: #928ba7; -fx-font-size: 15px; -fx-font-family: 'Super Mario World Text Box';" />
            </VBox>
            <StackPane fx:id="choirManualContainer" alignment="TOP_LEFT" />
        </HBox>

    </VBox>

    <!-- Bottom-Left Back to Menu Button -->
    <HBox fx:id="backButton" alignment="CENTER_LEFT" spacing="8.0" style="-fx-cursor: hand;" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="80.0">
        <Label text="&lt;-" style="-fx-text-fill: #bfa1db; -fx-font-size: 28px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
        <Label text="Back to Main Menu" style="-fx-text-fill: #bfa1db; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
    </HBox>

    <!-- Loading Screen Overlay (Visible on open, hidden once initialized) -->
    <AnchorPane fx:id="loadingOverlay" style="-fx-background-color: #3b3542;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox alignment="CENTER" spacing="25.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="400.0">
            <Label text="LOADING ORGAN WORKSPACE..." style="-fx-text-fill: #bfa1db; -fx-font-size: 38px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -4, 4);" />
            <Label text="Initializing Tonewheel MIDI Engine &amp; Manuals..." style="-fx-text-fill: #928ba7; -fx-font-size: 22px; -fx-font-family: 'Super Mario World Text Box';" />
        </VBox>
    </AnchorPane>

</AnchorPane>