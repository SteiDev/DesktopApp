<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #3b3542;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">

    <VBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="50.0" left="60.0" right="60.0" top="20.0" />
        </padding>

        <!-- Title Header -->
        <Label style="-fx-text-fill: #bfa1db; -fx-font-size: 150px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -10, 10);" text="SoundLab" />

        <!-- Central Box Container -->
        <VBox alignment="CENTER" maxWidth="620.0" spacing="22.0" style="-fx-background-color: #928ba7; -fx-padding: 35px; -fx-border-color: #2b2633; -fx-border-width: 5px;">
            
            <!-- Input Fields -->
            <TextField promptText="Email" style="-fx-background-color: #4b4459; -fx-text-fill: white; -fx-prompt-text-fill: #c5bcd4; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 25px; -fx-pref-height: 62px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
            
            <TextField promptText="Username" style="-fx-background-color: #4b4459; -fx-text-fill: white; -fx-prompt-text-fill: #c5bcd4; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 25px; -fx-pref-height: 62px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
            
            <PasswordField promptText="Password" style="-fx-background-color: #4b4459; -fx-text-fill: white; -fx-prompt-text-fill: #c5bcd4; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 25px; -fx-pref-height: 62px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />

            <!-- Side-by-Side Buttons (Added fx:id to Login button) -->
            <HBox alignment="CENTER" spacing="25.0">
                <Button fx:id="loginButton" text="Login" style="-fx-background-color: #4b4459; -fx-text-fill: white; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 25px; -fx-pref-width: 235px; -fx-pref-height: 58px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
                <Button text="Register" style="-fx-background-color: #4b4459; -fx-text-fill: white; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 25px; -fx-pref-width: 235px; -fx-pref-height: 58px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -5, 5);" />
            </HBox>
        </VBox>

        <!-- Enter as Guest Button -->
        <VBox alignment="CENTER" spacing="4.0" style="-fx-cursor: hand;">
            <Label text="Enter as Guest" style="-fx-text-fill: #d1c7e0; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 23px; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
            <Region maxWidth="240.0" prefHeight="3.0" style="-fx-background-color: #d1c7e0;" />
        </VBox>
    </VBox>

    <!-- Bottom-Right Shutdown Button -->
    <Button fx:id="shutdownButton" text="Shutdown" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 22px; -fx-pref-height: 48px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="60.0" />
</AnchorPane>