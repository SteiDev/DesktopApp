<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #3b3542;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ssd.project.frontend.AccountController">
    
    <!-- Top-Right Decorative Ring -->
    <Circle centerX="1750.0" centerY="150.0" radius="320.0" stroke="#bfa1db" strokeWidth="4.0" style="-fx-fill: transparent;" opacity="0.35" />

    <!-- Main Content Container -->
    <VBox spacing="30.0" AnchorPane.leftAnchor="150.0" AnchorPane.topAnchor="120.0">
        
        <!-- Account Title -->
        <Label text="Account Dashboard" style="-fx-text-fill: #bfa1db; -fx-font-size: 55px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -6, 6);" />

        <!-- Info Box Container -->
        <VBox spacing="20.0" style="-fx-background-color: #928ba7; -fx-padding: 40px; -fx-border-color: #2b2633; -fx-border-width: 5px; -fx-pref-width: 900px;">
            
            <!-- User Credentials Section -->
            <Label fx:id="usernameLabel" text="Username: John Doe" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box';" />
            <Label fx:id="emailLabel" text="Email: user@soundlab.com" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box';" />
            <Label fx:id="passwordLabel" text="Password: ********" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box';" />

            <!-- Spacer Line / Gap -->
            <VBox prefHeight="10.0" />

            <!-- Statistics Section -->
            <Label fx:id="quizzesCompletedLabel" text="Quizzes Completed: 12" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box';" />
            <Label fx:id="accuracyLabel" text="Answer Accuracy: 88.5%" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box';" />

            <!-- Spacer Line / Gap -->
            <VBox prefHeight="10.0" />

            <!-- Recommendations Section -->
            <Label text="Recommended Exercises:" style="-fx-text-fill: #3b3542; -fx-font-size: 32px; -fx-font-family: 'Super Mario World Text Box';" />
            <Label fx:id="recommendationLabel" text="- Interval Training: Minor Thirds&#10;- Chord Recognition: Dominant 7th" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-family: 'Super Mario World Text Box';" />
        </VBox>
    </VBox>

    <!-- Bottom-Left Back to Menu Button (Using Hack font for a clean arrow) -->
    <!-- Bottom-Left Back to Menu Button (Split Fonts) -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-cursor: hand;" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="80.0" fx:id="backButton">
        <Label text="&lt;-" style="-fx-text-fill: #bfa1db; -fx-font-size: 28px; -fx-font-family: 'Hack', monospace; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
        <Label text="Back" style="-fx-text-fill: #bfa1db; -fx-font-size: 28px; -fx-font-family: 'Super Mario World Text Box'; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" />
    </HBox>

    <!-- Bottom-Right Logout Button (Matching Shutdown style) -->
    <Button fx:id="logoutButton" text="Logout" style="-fx-background-color: #4b4459; -fx-text-fill: #bfa1db; -fx-font-family: 'Super Mario World Text Box'; -fx-font-size: 22px; -fx-pref-height: 48px; -fx-border-color: #2b2633; -fx-border-width: 3px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, #1a1523, 0, 0, -3, 3);" AnchorPane.bottomAnchor="60.0" AnchorPane.rightAnchor="80.0" />

</AnchorPane>